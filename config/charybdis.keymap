#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

// Key positions in the 34-key layout, for positional hold-tap.
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29
#define THUMBS 30 31 32 33

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    behaviors {
        // Home row mods tuned against misfires while typing fast:
        // - require-prior-idle-ms: a key pressed within 150 ms of the previous key is always a tap.
        // - hold-trigger-key-positions: a hold only resolves when the next key is on the
        //   other hand (or a thumb), so same-hand rolls like "as" or "df" stay letters.
        // - hold-trigger-on-release: lets you stack several same-hand mods (e.g. Ctrl+Shift).
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod Left";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod Right";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // Alt+Esc that hides a held Ctrl, so it stays Alt+Esc after the L2
        // Ctrl+Tab combos.
        alt_esc: alt_esc {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Alt+Esc (no Ctrl)";
            #binding-cells = <0>;
            bindings = <&kp LA(ESC)>, <&kp LA(ESC)>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        // L2 layer-tap for Del and /. Same timing as &lt. Releasing it also
        // releases the Ctrl that the L2 Ctrl+Tab combos press.
        lt_ctrl: layer_tap_release_ctrl {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Layer-Tap (releases Ctrl)";
            #binding-cells = <2>;
            bindings = <&mo_release_ctrl>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
        };

        // ponytail: releases LCTRL unconditionally. With no Ctrl held it is a no-op,
        // but a home-row Ctrl (D) held across the L2 release drops early.
        mo_release_ctrl: momentary_layer_release_ctrl {
            compatible = "zmk,behavior-macro-one-param";
            display-name = "Layer, then release Ctrl";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_param_1to1 &macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1 &macro_release &mo MACRO_PLACEHOLDER &kp LCTRL>
                ;
        };

        // Presses Ctrl (left held) and taps the given key.
        ctrl_then_tap: press_ctrl_then_tap {
            compatible = "zmk,behavior-macro-one-param";
            display-name = "Hold Ctrl, tap key";
            #binding-cells = <1>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_param_1to1 &macro_tap &kp MACRO_PLACEHOLDER>
                ;
        };

        // First press holds Ctrl and taps Tab. While Ctrl is held, later presses
        // only tap Tab, so Ctrl stays down until the L2 key is released.
        ctrl_tab: ctrl_tab_cycle {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Ctrl+Tab (holds Ctrl)";
            #binding-cells = <0>;
            bindings = <&ctrl_then_tap TAB>, <&kp TAB>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
            keep-mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        ctrl_shift_tab: ctrl_shift_tab_cycle {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Ctrl+Shift+Tab (holds Ctrl)";
            #binding-cells = <0>;
            bindings = <&ctrl_then_tap LS(TAB)>, <&kp LS(TAB)>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
            keep-mods = <(MOD_LCTL|MOD_RCTL)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Hold both right thumb keys (Space/L1 and Enter/Shift) together for layer 4
        // (Bluetooth, bootloader). Press them within 50 ms of each other.
        // require-prior-idle-ms: a Space-then-Shift roll while typing never fires it.
        right_thumbs_layer: right_thumbs_layer {
            key-positions = <32 33>;
            bindings = <&mo 4>;
            require-prior-idle-ms = <150>;
        };

        // Q+W together for Tab. No English word contains "qw", so typing never
        // triggers it. No require-prior-idle-ms: Tab right after typing must work.
        // ponytail: lists every layer with bindings except L2; add new layers here.
        tab_combo: tab_combo {
            key-positions = <0 1>;
            bindings = <&kp TAB>;
            layers = <0 1 3 4>;
        };

        // Q+W+E together for Shift+Tab, on the same layers as tab_combo.
        // Q+W now waits up to 50 ms for E before sending Tab.
        shift_tab_combo: shift_tab_combo {
            key-positions = <0 1 2>;
            bindings = <&kp LS(TAB)>;
            layers = <0 1 3 4>;
        };

        // Hold Del (L2), then Q+W for Ctrl+Tab or Q+W+E for Ctrl+Shift+Tab.
        // Ctrl stays held until Del is released. Q+W waits up to 50 ms for E.
        ctrl_tab_combo: ctrl_tab_combo {
            key-positions = <0 1>;
            bindings = <&ctrl_tab>;
            layers = <2>;
        };

        ctrl_shift_tab_combo: ctrl_shift_tab_combo {
            key-positions = <0 1 2>;
            bindings = <&ctrl_shift_tab>;
            layers = <2>;
        };

        // Hold Del (L2), then Q+W+E+R for Alt+Esc.
        alt_esc_combo: alt_esc_combo {
            key-positions = <0 1 2 3>;
            bindings = <&alt_esc>;
            layers = <2>;
        };

        // L+' together for ; (thumb Shift + L+' for :). The base key is '.
        // Order does not matter. The 30 ms window, shorter than the 50 ms
        // default, is meant to keep "'ll" rolls (I'll, we'll) as letters.
        // No require-prior-idle-ms: ; right after typing, as in "foo();", must work.
        // Layer 0 only: on layer 2 these keys are [ and ].
        semicolon_combo: semicolon_combo {
            key-positions = <18 19>;
            bindings = <&kp SEMI>;
            layers = <0>;
            timeout-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp Q           &kp W         &kp E           &kp R           &kp T    &kp Y        &kp U           &kp I           &kp O          &kp P
&hml LSHIFT A   &hml LALT S   &hml LCTRL D    &hml LGUI F     &kp G    &kp H        &hmr RGUI J     &hmr RCTRL K    &hmr RALT L    &hmr RSHIFT SQT
&kp Z           &kp X         &kp C           &kp V           &kp B    &kp N        &kp M           &kp COMMA       &kp DOT        &lt_ctrl 2 SLASH
                                              &lt_ctrl 2 DEL  &mt LGUI BSPC     &lt 1 SPACE  &mt RSHIFT ENTER
            >;

            sensor-bindings = <&scroll_vertical_encoder>;

            // 编码器1：上下滚动,,
        };

        layer_1 {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5     &trans     &kp C_BRI_DN  &kp C_BRI_UP  &trans      &kp GRAVE
&hml LSHIFT F6  &hml LALT F7  &hml LCTRL F8  &hml LGUI F9  &kp F10    &kp LEFT   &kp DOWN  &kp UP  &kp RIGHT  &trans
&kp F11  &kp F12  &trans  &trans  &trans     &kp C_PREV &kp K_VOL_DN  &kp K_VOL_UP  &kp C_NEXT  &kp K_MUTE
                          &trans  &trans     &trans     &kp C_PP
            >;
        };

        layer_2 {
            bindings = <
&gresc     &trans   &trans    &trans     &trans       &kp N7  &kp N8  &kp N9  &kp LBRC   &kp RBRC
&hml LSHIFT EXCL  &hml LALT AT  &hml LCTRL HASH  &hml LGUI DLLR  &kp PRCNT    &kp N4  &hmr RGUI N5  &hmr RCTRL N6  &hmr RALT LBKT  &hmr RSHIFT RBKT
&kp CARET  &kp AMPS &kp ASTRK &kp LPAR   &kp RPAR     &kp N1  &kp N2  &kp N3  &kp MINUS  &kp EQUAL
                           &trans   &trans     &kp N0  &kp SQT
            >;
        };

        layer_3 {
            bindings = <
&trans     &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&hml LSHIFT TAB  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                           &trans  &trans    &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&alt_esc     &trans  &trans  &trans  &trans    &trans         &trans         &trans         &trans  &bootloader
&trans       &trans  &trans  &trans  &trans    &trans         &trans         &trans         &trans  &trans
&trans       &trans  &trans  &trans  &trans    &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &trans  &bt BT_CLR
                        &trans  &trans    &trans         &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };

        layer_10 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };
    };
};
