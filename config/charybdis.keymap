#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

// Key positions in the 34-key layout, for positional hold-tap.
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29
#define THUMBS 30 31 32 33

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    behaviors {
        // Home row mods tuned against misfires while typing fast:
        // - require-prior-idle-ms: a key pressed within 150 ms of the previous key is always a tap.
        // - hold-trigger-key-positions: a hold only resolves when the next key is on the
        //   other hand (or a thumb), so same-hand rolls like "as" or "df" stay letters.
        // - hold-trigger-on-release: lets you stack several same-hand mods (e.g. Ctrl+Shift).
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod Left";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod Right";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // Shift on Z and / (layer 0): Shift goes down the moment Z or / is pressed
        // (hold-while-undecided), so Shift+click and Shift+scroll need no wait.
        // Another key pressed while Z or / is held gets Shift, from either hand,
        // with no timing rule. The key's own character types only on a quick tap:
        // released alone within 200 ms, Shift is released and z or / is typed.
        // Held alone past 200 ms it stays Shift and types nothing on release.
        // ponytail: a tap sends a lone Shift press before the letter, and a
        // Shift+click shorter than 200 ms still types z or / on release (the
        // board cannot see mouse clicks). Any overlap gives Shift, so z or /
        // rolled into the next key (size, amazon, /giphy) capitalizes that key.
        sft: shift_mod {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Shift Mod (hold-preferred)";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            hold-while-undecided;
        };

        // Z and / on layer 0. A hold-tap sends its character only on release, so
        // with another Shift already held (thumb, Z or /) a ? or Z came out
        // unshifted whenever that Shift was released first. When Shift is already
        // held at press, these send the plain key at once, with Shift kept;
        // otherwise they are the sft Shift hold-tap. One instance per key, since a
        // mod-morph cannot be pressed twice at once.
        sft_z: shift_mod_z_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Z / Shift";
            #binding-cells = <0>;
            bindings = <&sft LSHIFT Z>, <&kp Z>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sft_slash: shift_mod_slash_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "/ / Shift";
            #binding-cells = <0>;
            bindings = <&sft RSHIFT SLASH>, <&kp SLASH>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Right thumb Enter/Shift (layer 0): the stock &mt settings plus retro-tap.
        // Enter held alone past 200 ms and released with no other key still sends
        // Enter. Any key pressed during the hold gives Shift and cancels the Enter.
        // ponytail: with retro-tap, ZMK presses Shift only when another key goes
        // down, never on the timer, so Shift+click and Shift+scroll need Z or /.
        // Clicking during the hold, then releasing, sends Enter.
        mt_enter: mod_tap_retro_enter {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Mod-Tap (retro-tap)";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            retro-tap;
        };

        // Home row mods on L2, hold-preferred: the mod engages as soon as
        // the next key goes down, so GUI+number fires right away.
        // No hold-trigger-key-positions: hold-preferred decides on that key-down,
        // before hold-trigger-on-release records a position, and checking positions
        // on key-down would block same-hand stacking (# Ctrl + ^ Shift).
        // So one behavior serves both hands. require-prior-idle-ms still makes a
        // key pressed within 150 ms of the previous key a plain tap, because L2
        // symbols are typed in quick runs.
        hmhp: home_row_mod_hold_preferred {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod (hold-preferred)";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        // Mods on L1 (F-key / arrow layer): hmhp without require-prior-idle-ms or
        // quick-tap-ms. F-keys are rarely typed in runs, and both settings forced a
        // tap (F7 instead of Alt) on Alt+arrow pressed soon after another key, such
        // as a second Alt+Left or Alt right after typing s.
        hmnav: home_row_mod_nav {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Nav Layer Mod (hold-preferred)";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
        };

        // Alt+Esc that hides a held Ctrl, so it stays Alt+Esc after the L2
        // Ctrl+Tab combos.
        alt_esc: alt_esc {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Alt+Esc (no Ctrl)";
            #binding-cells = <0>;
            bindings = <&kp LA(ESC)>, <&kp LA(ESC)>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        // L2 layer-tap for Del. Same timing as &lt. Releasing it also
        // releases the Ctrl that the L2 Ctrl+Tab combos press.
        lt_ctrl: layer_tap_release_ctrl {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Layer-Tap (releases Ctrl)";
            #binding-cells = <2>;
            bindings = <&mo_release_ctrl>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            // Del held alone past 200 ms and released with no other key still
            // sends Delete. Any key (or L2 chord) pressed during the hold cancels it.
            retro-tap;
        };

        // ponytail: releases LCTRL unconditionally. With no Ctrl held it is a no-op,
        // but a home-row Ctrl (D) held across the L2 release drops early.
        mo_release_ctrl: momentary_layer_release_ctrl {
            compatible = "zmk,behavior-macro-one-param";
            display-name = "Layer, then release Ctrl";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_param_1to1 &macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1 &macro_release &mo MACRO_PLACEHOLDER &kp LCTRL>
                ;
        };

        // Presses Ctrl (left held) and taps the given key.
        ctrl_then_tap: press_ctrl_then_tap {
            compatible = "zmk,behavior-macro-one-param";
            display-name = "Hold Ctrl, tap key";
            #binding-cells = <1>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_param_1to1 &macro_tap &kp MACRO_PLACEHOLDER>
                ;
        };

        // First press holds Ctrl and taps Tab. While Ctrl is held, later presses
        // only tap Tab, so Ctrl stays down until the L2 key is released.
        ctrl_tab: ctrl_tab_cycle {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Ctrl+Tab (holds Ctrl)";
            #binding-cells = <0>;
            bindings = <&ctrl_then_tap TAB>, <&kp TAB>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
            keep-mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        ctrl_shift_tab: ctrl_shift_tab_cycle {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Ctrl+Shift+Tab (holds Ctrl)";
            #binding-cells = <0>;
            bindings = <&ctrl_then_tap LS(TAB)>, <&kp LS(TAB)>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
            keep-mods = <(MOD_LCTL|MOD_RCTL)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Hold both right thumb keys (Space/L1 and Enter/Shift) together for layer 3
        // (Bluetooth, bootloader). Press them within 50 ms of each other.
        // require-prior-idle-ms: a Space-then-Shift roll while typing never fires it.
        right_thumbs_layer: right_thumbs_layer {
            key-positions = <32 33>;
            bindings = <&mo 3>;
            require-prior-idle-ms = <150>;
        };

        // Q+W together for Tab. No English word contains "qw", so typing never
        // triggers it. No require-prior-idle-ms: Tab right after typing must work.
        // 100 ms window from the first key (default 50), the same as the L2 chords.
        // Typing "we" still types normally, but w shows up when you release W,
        // not after 50 ms.
        // ponytail: lists every layer with bindings except L2; add new layers here.
        tab_combo: tab_combo {
            key-positions = <0 1>;
            bindings = <&kp TAB>;
            layers = <0 1 3>;
            timeout-ms = <100>;
        };

        // Q+W+E together for Shift+Tab, on the same layers as tab_combo.
        // Q+W waits up to 100 ms after the first key for E before sending Tab.
        shift_tab_combo: shift_tab_combo {
            key-positions = <0 1 2>;
            bindings = <&kp LS(TAB)>;
            layers = <0 1 3>;
            timeout-ms = <100>;
        };

        // Hold Del (L2), then Q+W for Ctrl+Tab or Q+W+E for Ctrl+Shift+Tab.
        // Ctrl stays held until Del is released.
        // The L2 chords get a 100 ms window from the first key (default 50), so
        // the keys can land further apart. Releasing the keys fires the chord at
        // once; only a chord still held waits out the window for more keys.
        ctrl_tab_combo: ctrl_tab_combo {
            key-positions = <0 1>;
            bindings = <&ctrl_tab>;
            layers = <2>;
            timeout-ms = <100>;
        };

        ctrl_shift_tab_combo: ctrl_shift_tab_combo {
            key-positions = <0 1 2>;
            bindings = <&ctrl_shift_tab>;
            layers = <2>;
            timeout-ms = <100>;
        };

        // Hold Del (L2), then Q+W+E+R for Alt+Esc.
        alt_esc_combo: alt_esc_combo {
            key-positions = <0 1 2 3>;
            bindings = <&alt_esc>;
            layers = <2>;
            timeout-ms = <100>;
        };

        // L+' together for ; (thumb Shift + L+' for :). The base key is '.
        // Order does not matter. The 30 ms window, shorter than the 50 ms
        // default, is meant to keep "'ll" rolls (I'll, we'll) as letters.
        // No require-prior-idle-ms: ; right after typing, as in "foo();", must work.
        // Layer 0 only: on layer 2 these keys are [ and ].
        semicolon_combo: semicolon_combo {
            key-positions = <18 19>;
            bindings = <&kp SEMI>;
            layers = <0>;
            timeout-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp Q           &kp W         &kp E           &kp R           &kp T    &kp Y        &kp U           &kp I           &kp O          &kp P
&kp A           &hml LALT S   &hml LCTRL D    &hml LGUI F     &kp G    &kp H        &hmr RGUI J     &hmr RCTRL K    &hmr RALT L    &kp SQT
&sft_z          &kp X         &kp C           &kp V           &kp B    &kp N        &kp M           &kp COMMA       &kp DOT        &sft_slash
                                              &lt_ctrl 2 DEL  &mt LGUI BSPC     &lt 1 SPACE  &mt_enter RSHIFT ENTER
            >;

            sensor-bindings = <&scroll_vertical_encoder>;

            // 编码器1：上下滚动,,
        };

        layer_1 {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5     &trans     &kp C_BRI_DN  &kp C_BRI_UP  &trans      &kp GRAVE
&kp F6          &hmnav LALT F7  &hmnav LCTRL F8  &hmnav LGUI F9  &kp F10    &kp LEFT   &kp DOWN  &kp UP  &kp RIGHT  &trans
&hmnav LSHIFT F11  &kp F12  &trans  &trans  &trans     &kp C_PREV &kp K_VOL_DN  &kp K_VOL_UP  &kp C_NEXT  &hmnav RSHIFT K_MUTE
                          &trans  &trans     &trans     &kp C_PP
            >;
        };

        layer_2 {
            bindings = <
&gresc     &trans   &trans    &trans     &trans       &kp N7  &kp N8  &kp N9  &kp LBRC   &kp RBRC
&kp EXCL          &hmhp LALT AT  &hmhp LCTRL HASH  &hmhp LGUI DLLR  &kp PRCNT    &kp N4  &hmhp RGUI N5  &hmhp RCTRL N6  &hmhp RALT LBKT  &kp RBKT
&hmhp LSHIFT CARET  &kp AMPS &kp ASTRK &kp LPAR   &kp RPAR     &kp N1  &kp N2  &kp N3  &kp MINUS  &hmhp RSHIFT EQUAL
                           &trans   &trans     &kp N0  &trans
            >;
        };

        layer_3 {
            bindings = <
&alt_esc     &trans  &trans  &trans  &trans    &trans         &trans         &trans         &trans  &bootloader
&trans       &trans  &trans  &trans  &trans    &trans         &trans         &trans         &trans  &trans
&trans       &trans  &trans  &trans  &trans    &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &trans  &bt BT_CLR
                        &trans  &trans    &trans         &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };
    };
};
